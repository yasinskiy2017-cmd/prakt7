<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MovieCatalogApp.Controls"
             x:Class="MovieCatalogApp.Controls.MovieCardView"
             x:Name="this"
             x:DataType="controls:MovieCardView">
    <Border BindingContext="{Binding Source={x:Reference this}}"
            Style="{StaticResource MovieCardBorderStyle}">
        <Grid ColumnDefinitions="104,*" ColumnSpacing="14">
            <Border Grid.Column="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 9"
                    HeightRequest="150"
                    WidthRequest="104">
                <Image Aspect="AspectFill">
                    <Image.Source>
                        <UriImageSource Uri="{Binding Model.Poster}" CacheValidity="7.00:00:00" />
                    </Image.Source>
                </Image>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Start">
                <Label Text="{Binding Model.Title}" Style="{StaticResource MovieTitleLabelStyle}"
                       MaxLines="2" LineBreakMode="TailTruncation" />
                <HorizontalStackLayout Spacing="10">
                    <Label Text="{Binding Model.Year}" Style="{StaticResource MovieMetaLabelStyle}" />
                    <Label Text="{Binding Model.Rating}" Style="{StaticResource MovieRatingLabelStyle}" />
                </HorizontalStackLayout>
                <Label Text="{Binding Model.Description}" Style="{StaticResource MovieDescriptionLabelStyle}"
                       MaxLines="4" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
