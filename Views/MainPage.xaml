<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MovieCatalogApp.Models"
             xmlns:controls="clr-namespace:MovieCatalogApp.Controls"
             xmlns:vm="clr-namespace:MovieCatalogApp.ViewModels"
             x:Class="MovieCatalogApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Каталог фільмів"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}">
            <VerticalStackLayout Spacing="4">
                <Label Text="КІНОТЕКА" Style="{StaticResource HeaderTitleLabelStyle}" />
                <Label Text="Фільми та серіали · IMDb" Style="{StaticResource HeaderSubtitleLabelStyle}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView x:Name="MoviesCollectionView"
                        Grid.Row="1"
                        ItemsSource="{Binding TitlesVisible}"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                        Margin="12,10"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedMovie, Mode=TwoWay}"
                        SelectionChangedCommand="{Binding OpenMovieCommand}"
                        SelectionChangedCommandParameter="{Binding Source={x:Reference MoviesCollectionView}, Path=SelectedItem}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout x:Name="MoviesGridLayout"
                                 Orientation="Vertical"
                                 Span="1"
                                 VerticalItemSpacing="12"
                                 HorizontalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Movie">
                    <controls:MovieCardView Model="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" Padding="0,8" BackgroundColor="{StaticResource FooterBackgroundColor}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource AccentColor}"
                               HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
