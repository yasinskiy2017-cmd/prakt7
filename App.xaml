<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovieCatalogApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#512BD4</Color>
            <Color x:Key="PageBackgroundColor">#10131A</Color>
            <Color x:Key="CardBackgroundColor">#1B202B</Color>
            <Color x:Key="HeaderBackgroundColor">#191E29</Color>
            <Color x:Key="FooterBackgroundColor">#151A23</Color>
            <Color x:Key="AccentColor">#F5C518</Color>
            <Color x:Key="PrimaryTextColor">#F4F6FA</Color>
            <Color x:Key="SecondaryTextColor">#AAB2C0</Color>

            <Style x:Key="HeaderBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource HeaderBackgroundColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="18,17" />
            </Style>
            <Style x:Key="HeaderTitleLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="2" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="HeaderSubtitleLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
            <Style x:Key="MovieCardBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBackgroundColor}" />
                <Setter Property="Stroke" Value="#303847" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="11" />
            </Style>
            <Style x:Key="MovieTitleLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryTextColor}" />
            </Style>
            <Style x:Key="MovieMetaLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
            </Style>
            <Style x:Key="MovieRatingLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource AccentColor}" />
            </Style>
            <Style x:Key="MovieDescriptionLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="LineHeight" Value="1.15" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
